# ---------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------

# Public site URL (used for canonical links, sitemap, Open Graph, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used ONLY by /api/contact to store messages. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Contact form email delivery via Resend (https://resend.com) — server-only
RESEND_API_KEY=
CONTACT_TO_EMAIL=masumjubayel@gmail.com
# Must be a sender on a domain verified in Resend (onboarding@resend.dev works for testing)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: protects /api/keepalive (Vercel sends it automatically to the daily cron job)
CRON_SECRET=replace-with-another-long-random-string

# Random string used to hash visitor IPs for rate limiting (no raw IPs are stored)
IP_HASH_SALT=replace-with-a-long-random-string

# Optional public overrides (otherwise set in src/lib/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=masumjubayel@gmail.com
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
# Point to an externally hosted resume PDF instead of /public/resume/...
NEXT_PUBLIC_RESUME_URL=
